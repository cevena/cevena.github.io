---
interface Props {
  title: string;
  description: string;
  navBrand: string;
  navYear: string;
  navLinks: { label: string; href: string }[];
  footerText: string;
  contactEmail: string;
}

const { title, description, navBrand, navYear, navLinks, footerText, contactEmail } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-light-512.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/favicon-dark-512.png" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..800,0..100,0..1;1,9..144,300..800,0..100,0..1&family=IBM+Plex+Mono:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        var mode = localStorage.getItem('theme') || 'system';
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolved = mode === 'system' ? (prefersDark ? 'dark' : 'light') : mode;
        document.documentElement.setAttribute('data-theme', resolved);
        document.documentElement.setAttribute('data-theme-mode', mode);
      })();
    </script>
  </head>

  <body>
    <nav>
      <div class="nav-inner">
        <a href="#" class="nav-brand" aria-label={`${navBrand} ${navYear}`}>
          <img class="nav-logo nav-logo-light" src="/cevnac-logo-light.svg" alt={`${navBrand} ${navYear}`} width="1370" height="401" />
          <img class="nav-logo nav-logo-dark" src="/cevnac-logo-dark.svg" alt="" aria-hidden="true" width="1370" height="401" />
        </a>
        <div class="nav-links">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
        <div class="nav-right">
          <button id="theme-toggle" type="button" aria-label="Toggle theme">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <svg class="icon-system" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </button>
          <button id="menu-toggle" type="button" aria-label="Toggle menu" class="menu-toggle">
            <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="container">
        <p>{footerText}</p>
        <p class="footer-sub">Questions? Contact us at <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle')!;
      const cycle: Record<string, string> = { light: 'dark', dark: 'system', system: 'light' };

      function applyTheme(mode: string) {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const resolved = mode === 'system' ? (prefersDark ? 'dark' : 'light') : mode;
        document.documentElement.setAttribute('data-theme', resolved);
        document.documentElement.setAttribute('data-theme-mode', mode);
        if (mode === 'system') {
          localStorage.removeItem('theme');
        } else {
          localStorage.setItem('theme', mode);
        }
      }

      toggle.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme-mode') || 'system';
        applyTheme(cycle[current]);
      });

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        const mode = document.documentElement.getAttribute('data-theme-mode');
        if (mode === 'system') {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        }
      });

      const menuToggle = document.getElementById('menu-toggle')!;
      const nav = menuToggle.closest('nav')!;
      menuToggle.addEventListener('click', () => {
        nav.classList.toggle('open');
      });
      nav.querySelectorAll('.nav-links a').forEach((link) => {
        link.addEventListener('click', () => {
          nav.classList.remove('open');
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-serif: 'EB Garamond', 'Georgia', serif;
    --font-display: 'Fraunces', 'EB Garamond', 'Georgia', serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --font-sans: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;

    /* Warm cream paper, calibrated to the watercolor plate */
    --c-bg: #f5efe3;
    --c-bg-alt: #ede5d2;
    --c-text: #1e1c17;
    --c-text-secondary: #5e5749;
    --c-border: #d5cab1;
    --c-rule: #b9ac8b;
    --c-nav-bg: rgba(245, 239, 227, 0.94);

    /* Watercolor palette pulled from the skyline plate */
    --c-terracotta: #c45a4e;
    --c-sage: #7e9587;
    --c-ochre: #c0944a;
    --c-slate: #6b8593;
    --c-rose: #c18d7c;
    --c-plum: #8c5e6f;

    /* Default accent — terracotta as the lead voice */
    --c-accent: var(--c-terracotta);
    --c-accent-dark: #a44539;
    --c-link: var(--c-terracotta);
    --c-link-hover: #2d2a24;

    --c-ink-soft: rgba(45, 42, 36, 0.55);
  }

  :root[data-theme="dark"] {
    /* Lamplight — same palette glowing against dark ink */
    --c-bg: #1d1b25;
    --c-bg-alt: #25232f;
    --c-text: #f0e6d4;
    --c-text-secondary: #b4a78e;
    --c-border: #3a3645;
    --c-rule: #4f4858;
    --c-nav-bg: rgba(29, 27, 37, 0.94);

    --c-terracotta: #e6816f;
    --c-sage: #9fb8a6;
    --c-ochre: #d9b35e;
    --c-slate: #93ade0;
    --c-rose: #d8a895;
    --c-plum: #b58598;

    --c-accent: var(--c-terracotta);
    --c-accent-dark: #f0a08f;
    --c-link: var(--c-terracotta);
    --c-link-hover: var(--c-text);

    --c-ink-soft: rgba(240, 230, 212, 0.5);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.75;
    color: var(--c-text);
    background: var(--c-bg);
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "onum" 1, "kern" 1, "liga" 1;
  }

  ::selection {
    background: var(--c-text);
    color: var(--c-bg);
  }

  /* Navigation */
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-nav-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--c-rule);
  }

  .nav-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    color: var(--c-text);
    text-decoration: none;
  }

  .nav-logo {
    height: 24px;
    width: auto;
    display: block;
  }

  .nav-logo-dark { display: none; }

  :root[data-theme="dark"] .nav-logo-light { display: none; }
  :root[data-theme="dark"] .nav-logo-dark { display: block; }

  .nav-year {
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--c-text-secondary);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-left: 0.4rem;
    vertical-align: 1px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--c-text-secondary);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--c-text);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.2rem;
    cursor: pointer;
    color: var(--c-text-secondary);
  }

  .menu-toggle:hover {
    color: var(--c-text);
  }

  .icon-close { display: none; }
  nav.open .icon-menu { display: none; }
  nav.open .icon-close { display: inline; }

  #theme-toggle {
    background: none;
    border: 1px solid var(--c-border);
    border-radius: 4px;
    padding: 0.3rem 0.4rem;
    cursor: pointer;
    color: var(--c-text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, border-color 0.2s;
    line-height: 1;
  }

  #theme-toggle:hover {
    color: var(--c-text);
    border-color: var(--c-rule);
  }

  .icon-sun, .icon-moon, .icon-system { display: none; }
  :root[data-theme-mode="light"] .icon-sun { display: inline; }
  :root[data-theme-mode="dark"] .icon-moon { display: inline; }
  :root[data-theme-mode="system"] .icon-system { display: inline; }

  /* Shared section styles — quiet, calibrated whitespace */
  .section {
    padding: 3rem 1.5rem;
    position: relative;
  }

  .section-alt {
    background: var(--c-bg-alt);
  }

  .container {
    max-width: 680px;
    margin: 0 auto;
    position: relative;
  }

  /* Section head — just the title with a hairline rule below */
  .section-head {
    position: relative;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--c-border);
  }

  .section-eyebrow {
    display: none;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.15rem);
    font-weight: 400;
    color: var(--c-text);
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 0;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--c-text);
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
    font-variation-settings: "opsz" 36, "SOFT" 30, "WONK" 0;
  }

  .section-note {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--c-text-secondary);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .about-content p {
    margin-bottom: 1.4rem;
    color: var(--c-text);
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-content p:last-child {
    margin-bottom: 0;
  }

  .section a {
    color: var(--c-text);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    transition: color 0.2s, border-color 0.2s;
  }

  .section a:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .asterism {
    display: none;
  }

  /* Footer */
  footer {
    padding: 3rem 1.5rem 4rem;
    text-align: center;
    border-top: 1px solid var(--c-rule);
  }

  footer p {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-secondary);
  }

  .footer-sub {
    margin-top: 0.6rem;
    font-size: 0.85rem !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    font-family: var(--font-serif) !important;
    font-style: italic;
    color: var(--c-text-secondary);
  }

  footer a {
    color: var(--c-text);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    transition: color 0.2s, border-color 0.2s;
  }

  footer a:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .menu-toggle {
      display: inline-flex;
    }

    .nav-links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0 0.25rem;
      order: 3;
    }

    nav.open .nav-links {
      display: flex;
    }

    .nav-links a {
      font-size: 0.82rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--c-border);
    }

    .nav-links a:last-child {
      border-bottom: none;
    }

    .section {
      padding: 3.5rem 1.25rem;
    }

    h2 {
      font-size: 1.55rem;
    }
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, fmt } from "../../utils/time";
import { generateCalendarLinks, generateScheduleIcs } from "../../utils/calendar";

const workshopShort = "CEVNAC";
const workshopTitle = "Compilation, Emulation and Verification of Neutral Atom Computing";
const conference = "IEEE Quantum Week";
const year = "2026";
const date = "Wednesday, September 16, 2026";
const location = "Toronto, Ontario, Canada";

// Calendar config — workshop is Wednesday, Sept 16, 2026 (block times per QCE)
const calConfig = {
  title: `${workshopShort} ${year}: ${workshopTitle}`,
  location: "Metro Toronto Convention Centre, Toronto, Ontario, Canada",
  description: `Workshop at ${conference} ${year}.\n${workshopTitle}\nhttps://cevnac.github.io/2026/`,
  date: "20260916",
  timezone: "America/Toronto",
  startMins: t(10, 0),
  endMins: t(16, 30),
};

const { gcalUrl, outlookUrl } = generateCalendarLinks(calConfig);

const schedule = [
  // Session 1 · 10:00–11:30 — Opening & landscape
  { start: t(10, 0),  end: t(10, 5),  title: "Welcome & Framing",                    speaker: "Xiu-Zhe (Roger) Luo · QuEra",       abstract: "" },
  { start: t(10, 5),  end: t(10, 20), title: "Invited Talk (title TBA)",             speaker: "Yannick Stade · TU Munich", abstract: "" },
  { start: t(10, 20), end: t(10, 35), title: "Advancing Compilation and Simulation of Neutral Atoms", speaker: "Kyungjoo Noh · NVIDIA",     abstract: "" },
  { start: t(10, 35), end: t(10, 45), title: "Break",                                speaker: "",                          abstract: "" },
  { start: t(10, 45), end: t(11, 0),  title: "QuEra Neutral-Atom Stack: Overview",   speaker: "Xiu-Zhe (Roger) Luo · QuEra",       abstract: "" },
  { start: t(11, 0),  end: t(11, 15), title: "Bottlenecks and Optimizations in Fault-Tolerant Compilation on Neutral Atoms", speaker: "Tim (Yi-Ting) Chen · AWS", abstract: "Neutral-atom architectures open up different opportunities to optimize quantum programs than their superconducting counterparts: reconfigurable connectivity via atom movement, zone-structured hardware, and global gate application all offer degrees of freedom that a fixed coupling map cannot express. This talk examines how a compiler can exploit these opportunities for fault-tolerant programs by reasoning about the underlying physical mechanisms. When neutral atom-based fault-tolerant quantum computing arrives on AWS, compilers that take advantage of these controls will power the most impactful workloads." },
  { start: t(11, 15), end: t(11, 30), title: "Invited Talk (title TBA)",             speaker: "Hanyu · UCLA",              abstract: "" },
  { start: t(11, 30), end: t(13, 0),  title: "Lunch",                                speaker: "",                          abstract: "" },
  // Session 2 · 13:00–14:30 — Architecture, compilation & tools
  { start: t(13, 0),  end: t(13, 15), title: "Lane Architecture",                    speaker: "Phillip Weinberg · QuEra",  abstract: "" },
  { start: t(13, 15), end: t(13, 30), title: "EGS Algorithm",                        speaker: "Jason Ludmir · Rice",       abstract: "" },
  { start: t(13, 30), end: t(13, 45), title: "Invited Talk (title TBA)",             speaker: "Ludwig Schmid · TU Munich", abstract: "" },
  { start: t(13, 45), end: t(13, 55), title: "Break",                                speaker: "",                          abstract: "" },
  { start: t(13, 55), end: t(14, 10), title: "Real-time DEM Generation",             speaker: "Xiang Fang · UCSD",         abstract: "" },
  { start: t(14, 10), end: t(14, 30), title: "Live Demo: ppvm + deq", speaker: "Rafael Haenel · QuEra",     abstract: "" },
  { start: t(14, 30), end: t(15, 0),  title: "Break",                                speaker: "",                          abstract: "" },
  // Session 3 · 15:00–16:30 — Community, scheduling & panel
  { start: t(15, 0),  end: t(15, 10), title: "Contributed Talk (open call)",         speaker: "TBA",                       abstract: "" },
  { start: t(15, 10), end: t(15, 20), title: "Contributed Talk (open call)",         speaker: "TBA",                       abstract: "" },
  { start: t(15, 20), end: t(15, 35), title: "Compilation Pipeline and Shuttling Optimization for Neutral Atom Quantum Computing", speaker: "Jixuan · QuEra + UCSD",     abstract: "Neutral atom quantum computing offers unique advantages through mobile qubits and flexible connectivity. However, mapping quantum circuits onto these physical platforms requires addressing complex spatial and timing constraints. This workshop introduces an end to end compilation pipeline tailored for neutral atom architectures. We will discuss how to optimize atom shuttling to fully exploit distinct hardware capabilities, including parallel acousto optic deflector operations and zoned architectures. Additionally, we will discuss potential applications of AI and machine learning to accelerate these optimization tasks, aiming to improve overall compilation efficiency and execution fidelity." },
  { start: t(15, 35), end: t(16, 25), title: "Panel Discussion",                     speaker: "Moderated by Xiu-Zhe (Roger) Luo", abstract: "" },
  { start: t(16, 25), end: t(16, 30), title: "Closing Remarks",                      speaker: "Xiu-Zhe (Roger) Luo · QuEra", abstract: "" },
];

const icsUri = generateScheduleIcs(schedule, {
  date: calConfig.date,
  timezone: calConfig.timezone,
  location: calConfig.location,
  prefix: workshopShort,
});

// Grouped by affiliation; members alphabetized by last name within each group
const affiliations = [
  {
    name: "QuEra Computing Inc.",
    location: "Boston · Toronto",
    members: [
      { name: "Rafael Haenel", url: "https://www.linkedin.com/in/rafael-haenel/" },
      { name: "Pedro Lopes", url: "https://www.linkedin.com/in/pedrolslopes/" },
      { name: "Xiu-Zhe (Roger) Luo", url: "https://rogerluo.dev" },
      { name: "Phillip Weinberg", url: "https://www.linkedin.com/in/phillip-weinberg-a8a55262/" },
      { name: "Jonathan Wurtz", url: "https://www.linkedin.com/in/jonathan-wurtz-7a4855181/" },
    ],
  },
  {
    name: "Technical University of Munich",
    location: "Munich, Germany",
    members: [
      { name: "Lukas Burgholzer", url: "https://www.cda.cit.tum.de/team/burgholzer/" },
      { name: "Ludwig Schmid", url: "" },
      { name: "Yannick Stade", url: "https://www.cda.cit.tum.de/team/stade/" },
      { name: "Robert Wille", url: "https://www.cda.cit.tum.de/team/wille/" },
    ],
  },
  {
    name: "University of California",
    location: "Los Angeles · San Diego",
    members: [
      { name: "Jason Cong", url: "", subAffiliation: "UCLA" },
      { name: "Yufei Ding", url: "", subAffiliation: "UCSD" },
    ],
  },
];

const breaks = new Set(["Lunch", "Break"]);
---

<BaseLayout
  title={`${workshopTitle} — ${workshopShort} ${year}`}
  description={`${workshopTitle}. A workshop at ${conference} ${year}.`}
  navBrand={workshopShort}
  navYear={year}
  navLinks={[
    { label: "About", href: "#about" },
    { label: "Schedule", href: "#schedule" },
    { label: "Organizers", href: "#organizers" },
    { label: "Venue", href: "#venue" },
  ]}
  footerText={`${workshopShort} ${year} — Workshop at ${conference}`}
  contactEmail="rluo@quera.com"
>
  <header class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">
        <span>{workshopShort} {year}</span>
        <span class="dot">·</span>
        <a href="https://qce.quantum.ieee.org/2026/" target="_blank" rel="noopener noreferrer">A workshop at IEEE QCE</a>
      </p>
      <h1 class="hero-title">
        Compilation, Emulation <span class="amp">&amp;</span> Verification of Neutral Atom Computing
      </h1>
      <p class="hero-deck">
        A community workshop on open problems in the neutral-atom software stack —
        compilation, emulation, and verification.
      </p>
      <p class="hero-meta">
        <span>{date}</span>
        <span class="dot">·</span>
        <span>Metro Toronto Convention Centre, Toronto</span>
      </p>
    </div>
    <div class="hero-skyline" aria-hidden="true"></div>
    <div class="hero-skyline-fade" aria-hidden="true"></div>
  </header>

  <main>
    <section id="about" class="section" data-color="terracotta">
      <div class="container">
        <header class="section-head">
          <div>
            <span class="section-eyebrow">Abstract</span>
            <h2>About the Workshop</h2>
          </div>
        </header>
        <div class="about-content">
          <p class="lede">Neutral atom quantum computing is advancing rapidly toward fault-tolerant scale, opening rich software-level problems across compilers, emulators, and programming languages.</p>
          <p>
            This workshop convenes software developers and researchers to exchange ideas and identify open challenges. Focus areas: <em>(i)</em> move compilation with arbitrary qubit moves; <em>(ii)</em> move scheduling under fixed-lane architectures; <em>(iii)</em> realistic emulation; and <em>(iv)</em> languages and formal verification.
          </p>
        </div>

        <h3 class="subhead">Open Problems</h3>
        <ol class="challenges">
          <li class="challenge">
            <h4>No converged programming model</h4>
            <p>Architectures range from monolithic to zoned to fixed-lane, and continuous atom reloading keeps shifting what's programmable at the hardware level.</p>
          </li>
          <li class="challenge">
            <h4>Move optimization</h4>
            <p>Qubit move optimization remains open — especially around how it integrates with error correction and hardware–software–algorithm co-design.</p>
          </li>
          <li class="challenge">
            <h4>Scalable emulation &amp; verification</h4>
            <p>Error-correction experiments already run on 100+ physical qubits. Simulating them under realistic noise calls for methods beyond conventional approaches.</p>
          </li>
          <li class="challenge">
            <h4>Program correctness</h4>
            <p>The asynchronous, parallel model these devices enable creates a verification challenge — with clear analogies to formal verification in classical software.</p>
          </li>
        </ol>
      </div>
    </section>

    <section id="outcomes" class="section section-alt" data-color="sage">
      <div class="container">
        <header class="section-head">
          <div>
            <span class="section-eyebrow">Anticipated</span>
            <h2>Outcomes &amp; Aspirations</h2>
          </div>
        </header>
        <ul class="aims">
          <li>Consolidate a fragmented research community around open software challenges.</li>
          <li>Develop a shared roadmap of open problems and promising directions.</li>
          <li>Surface common abstractions across compilation, emulation, verification, and language design — toward shared infrastructure and standards.</li>
        </ul>
      </div>
    </section>

    <section id="schedule" class="section" data-color="ochre">
      <div class="container">
        <header class="section-head">
          <div>
            <span class="section-eyebrow">The Programme</span>
            <h2>Order of the Day</h2>
          </div>
        </header>
        <div class="about-content">
          <p>
            Three 90-minute sessions across the day (10:00–16:30). Short invited talks from across the neutral-atom ecosystem — QuEra, TU Munich, NVIDIA, AWS, UCSD, Rice, and UCLA — plus two open-call contributed talks, a live tools demo, and a closing panel.
          </p>
        </div>
        <p class="section-note">— Tentative programme; all times local to {location.split(",")[0]}.</p>
        <div class="schedule-table">
          <table>
            <thead>
              <tr>
                <th class="col-time">Time</th>
                <th class="col-duration">Duration</th>
                <th class="col-session">Session</th>
                <th class="col-speaker">Speaker</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((item) => (
                <tr class={breaks.has(item.title) ? "break-row" : ""}>
                  <td class="schedule-time">{fmt(item.start)} – {fmt(item.end)}</td>
                  <td class="schedule-duration">{item.end - item.start} min</td>
                  <td class="schedule-title">
                    {item.abstract ? (
                      <details class="talk-details">
                        <summary><span class="abstract-tag">[abstract]</span> {item.title}</summary>
                        <p class="talk-abstract">{item.abstract}</p>
                      </details>
                    ) : (
                      item.title
                    )}
                  </td>
                  <td class="schedule-speaker">{item.speaker}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="calendar-actions">
          <span class="calendar-label">Add to calendar:</span>
          <a href={gcalUrl} target="_blank" rel="noopener noreferrer">Google</a>
          <span class="calendar-sep">/</span>
          <a href={outlookUrl} target="_blank" rel="noopener noreferrer">Outlook</a>
          <span class="calendar-sep">·</span>
          <a href={icsUri} download="cevnac-2026.ics">Download full schedule (.ics)</a>
        </div>
      </div>
    </section>

    <section id="organizers" class="section section-alt" data-color="slate">
      <div class="container">
        <header class="section-head">
          <div>
            <span class="section-eyebrow">Editorial Board</span>
            <h2>Organisers &amp; Contributors</h2>
          </div>
        </header>
        <div class="affiliations">
          {affiliations.map((aff) => (
            <div class="affiliation">
              <div class="affiliation-head">
                <h3 class="affiliation-name">{aff.name}</h3>
                <span class="affiliation-location">{aff.location}</span>
              </div>
              <ul class="members">
                {aff.members.map((m) => (
                  <li class="member">
                    {m.url ? (
                      <a href={m.url} target="_blank" rel="noopener noreferrer" class="member-link">
                        <span class="member-name">{m.name}</span>
                        {m.subAffiliation && <span class="member-sub">{m.subAffiliation}</span>}
                        <svg class="member-arrow" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                      </a>
                    ) : (
                      <span class="member-link member-link--inert">
                        <span class="member-name">{m.name}</span>
                        {m.subAffiliation && <span class="member-sub">{m.subAffiliation}</span>}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="venue" class="section section-alt" data-color="plum">
      <div class="container">
        <header class="section-head">
          <div>
            <span class="section-eyebrow">Locale &amp; Audience</span>
            <h2>Venue &amp; Audience</h2>
          </div>
        </header>
        <div class="about-content meta-grid">
          <div>
            <h3 class="meta-h">Venue</h3>
            <p>Co-located with <a href="https://qce.quantum.ieee.org/2026/" target="_blank" rel="noopener noreferrer"><strong>{conference} 2026</strong></a> at the Metro Toronto Convention Centre, {location}.</p>
          </div>
          <div>
            <h3 class="meta-h">Audience</h3>
            <p>Researchers and developers working on neutral atom software — graduate students and early-career researchers especially welcome.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ─── Hero — single fold, skyline as ambient background ─── */
  .hero {
    position: relative;
    min-height: clamp(460px, 70vh, 640px);
    padding: 3rem 1.5rem 1.5rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-content {
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--c-text-secondary);
    margin-bottom: 1.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .hero-eyebrow .dot {
    opacity: 0.5;
  }

  .hero-eyebrow a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    transition: color 0.2s, border-color 0.2s;
  }

  .hero-eyebrow a:hover {
    color: var(--c-text);
    border-color: var(--c-text);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.85rem, 4.6vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--c-text);
    margin: 0;
    font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 0;
    max-width: 18ch;
  }

  .amp {
    color: var(--c-accent);
  }

  .hero-deck {
    max-width: 540px;
    margin: 1.75rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--c-text);
  }

  .hero-meta {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-rule);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    max-width: 540px;
  }

  .hero-meta .dot {
    opacity: 0.5;
  }

  /* Skyline + fade overlay share the SAME box sized to the image's
     natural 1620:832 aspect-ratio. Height grows with the hero but never
     wider than the viewport — so on ultra-wide and narrow screens the
     fade always lands on the image's actual edges, not viewport edges. */
  .hero-skyline,
  .hero-skyline-fade {
    position: absolute;
    bottom: 0;
    right: 0;
    height: min(100%, calc(100vw * 832 / 1620));
    aspect-ratio: 1620 / 832;
    pointer-events: none;
    z-index: 1;
  }

  .hero-skyline {
    background-image: url("/toronto-skyline.png");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    mix-blend-mode: multiply;
    /* Default = ultra-wide: image and title don't overlap, full presence */
    opacity: 0.9;
    filter: blur(0);
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  /* Standard widths (≤ ~2000px = typical desktops): title overlaps the
     image, so blur + lower opacity so the dark building lines don't
     compete with the black title text. */
  @media (max-width: 2000px) {
    .hero-skyline {
      opacity: 0.55;
      filter: blur(1.5px);
    }
  }

  /* Narrow widths: image sits squarely behind the title — soften more */
  @media (max-width: 1100px) {
    .hero-skyline {
      opacity: 0.42;
      filter: blur(2.5px);
    }
  }

  /* Cream gradients painted on top of the image, sized to the image */
  .hero-skyline-fade {
    background:
      linear-gradient(to right,  var(--c-bg) 0%, var(--c-bg) 6%, rgba(245,239,227,0.6) 22%, transparent 42%),
      linear-gradient(to bottom, var(--c-bg) 0%, rgba(245,239,227,0.55) 12%, transparent 28%),
      linear-gradient(to top,    var(--c-bg) 0%, rgba(245,239,227,0.55) 8%, transparent 22%);
  }

  :root[data-theme="dark"] .hero-skyline {
    mix-blend-mode: screen;
    filter: invert(1) hue-rotate(180deg) brightness(0.9) saturate(0.85);
    opacity: 0.7;
  }

  @media (max-width: 2000px) {
    :root[data-theme="dark"] .hero-skyline {
      opacity: 0.4;
      filter: invert(1) hue-rotate(180deg) brightness(0.9) saturate(0.85) blur(1.5px);
    }
  }

  @media (max-width: 1100px) {
    :root[data-theme="dark"] .hero-skyline {
      opacity: 0.3;
      filter: invert(1) hue-rotate(180deg) brightness(0.9) saturate(0.85) blur(2.5px);
    }
  }

  :root[data-theme="dark"] .hero-skyline-fade {
    background:
      linear-gradient(to right,  var(--c-bg) 0%, var(--c-bg) 6%, rgba(29,27,37,0.6) 22%, transparent 42%),
      linear-gradient(to bottom, var(--c-bg) 0%, rgba(29,27,37,0.55) 12%, transparent 28%),
      linear-gradient(to top,    var(--c-bg) 0%, rgba(29,27,37,0.55) 8%, transparent 22%);
  }

  .lede {
    font-size: 1.05rem !important;
  }

  /* Two-column meta grid (venue + audience) */
  .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .meta-h {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-text-secondary);
    margin: 0 0 0.6rem;
    font-weight: 400;
  }

  .meta-grid p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .meta-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  /* ─── Open Problems list ─────────────────────────────────── */
  .subhead {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--c-text);
    margin: 2.25rem 0 1.25rem;
    font-variation-settings: "opsz" 36, "SOFT" 30, "WONK" 0;
  }

  /* ─── Aims list — Outcomes section ──────────────────────── */
  .aims {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .aims li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--c-text);
  }

  .aims li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--c-accent);
  }

  .challenges {
    list-style: none;
    padding: 0;
    counter-reset: challenge;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin: 0;
  }

  .challenge {
    counter-increment: challenge;
    position: relative;
    padding-left: 3rem;
  }

  .challenge::before {
    content: counter(challenge, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--c-text-secondary);
    letter-spacing: 0.1em;
  }

  .challenge h4 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--c-text);
    margin-bottom: 0.65rem;
    font-variation-settings: "opsz" 36, "SOFT" 30, "WONK" 0;
  }

  .challenge p {
    font-size: 1rem;
    color: var(--c-text);
    line-height: 1.75;
  }

  /* ─── Schedule — quiet table ────────────────────────────── */
  .schedule-table {
    overflow-x: auto;
    margin-top: 1rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  thead th {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-text-secondary);
    text-align: left;
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--c-rule);
  }

  tbody td {
    padding: 0.85rem 0.75rem;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--c-border);
    vertical-align: top;
  }

  .col-time { width: 140px; }
  .col-duration { width: 70px; }
  .col-speaker { width: 130px; }

  .schedule-time {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--c-text);
    font-size: 0.8rem;
  }

  .schedule-duration {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;

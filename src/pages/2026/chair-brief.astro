---
import ChairScheduleEntry from "../../components/chairs/ChairScheduleEntry.astro";
import { schedule, sessions } from "../../data/2026/schedule";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fmt } from "../../utils/time";
---

<BaseLayout
  title="Chair's Brief — CEVNAC 2026"
  description="Workshop running order, speaker biographies, and read-aloud introductions for CEVNAC 2026 program chairs."
  robots="noindex, nofollow"
  navBrand="CEVNAC"
  navYear="2026"
  brandHref="#top"
  navLinks={[]}
  footerText="CEVNAC 2026 — Program Chair Brief"
  contactEmail="rluo@quera.com"
>
  <main id="top" class="chair-brief">
    <header class="chair-hero">
      <p class="chair-eyebrow">CEVNAC 2026 · Program chair field guide</p>
      <h1>Chair's Brief</h1>
      <p class="chair-meta">Wednesday, September 16 · Metro Toronto Convention Centre</p>
      <p class="chair-privacy">Unlisted public URL · chair-use material</p>
    </header>

    <nav class="session-jumps" aria-label="Jump to workshop session">
      {sessions.map((session) => (
        <a href={`#${session.id}`}>{session.label}</a>
      ))}
    </nav>

    <div class="chair-sessions">
      {sessions.map((session) => {
        const headingId = `${session.id}-heading`;
        return (
          <section id={session.id} class="chair-session" aria-labelledby={headingId}>
            <header class="chair-session__heading">
              <p>{session.label} · {fmt(session.start)}–{fmt(session.end)}</p>
              <h2 id={headingId}>{session.title}</h2>
            </header>

            <div class="chair-session__entries">
              {schedule
                .filter((entry) => entry.sessionId === session.id)
                .map((entry) => <ChairScheduleEntry entry={entry} />)}
            </div>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style is:global>
  .chair-brief {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1rem 5rem;
  }

  .chair-hero {
    padding: clamp(3.5rem, 10vw, 6.5rem) 0 2.5rem;
    border-bottom: 1px solid var(--c-rule);
  }

  .chair-eyebrow,
  .chair-meta,
  .chair-privacy,
  .chair-session__heading p,
  .chair-entry__kind,
  .chair-material-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .chair-eyebrow {
    color: var(--c-accent-dark);
    font-size: 0.68rem;
    margin-bottom: 1rem;
  }

  .chair-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 14vw, 6.5rem);
    font-weight: 400;
    font-variation-settings: "opsz" 144, "SOFT" 20, "WONK" 0;
    letter-spacing: -0.055em;
    line-height: 0.88;
    overflow-wrap: anywhere;
  }

  .chair-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 1.75rem;
    color: var(--c-text-secondary);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .chair-privacy {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--c-border);
    color: var(--c-text-secondary);
    font-size: 0.62rem;
    line-height: 1.4;
  }

  .session-jumps {
    position: sticky;
    top: var(--nav-bar-height);
    z-index: 90;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 -1rem;
    background: var(--c-nav-bg);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-rule);
  }

  .session-jumps a {
    min-width: 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.25rem;
    border-right: 1px solid var(--c-border);
    color: var(--c-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .session-jumps a:last-child {
    border-right: 0;
  }

  .session-jumps a:hover {
    color: var(--c-accent-dark);
  }

  .session-jumps a:focus-visible,
  .chair-entry summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }

  .chair-session {
    padding-top: 4rem;
    scroll-margin-top: calc(var(--nav-bar-height) + 52px);
  }

  .chair-session__heading {
    padding: 0 0 1.2rem 1rem;
    border-left: 4px solid var(--c-accent);
    border-bottom: 1px solid var(--c-rule);
  }

  .chair-session__heading p {
    color: var(--c-text-secondary);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .chair-session__heading h2 {
    margin-top: 0.4rem;
    font-size: clamp(1.75rem, 8vw, 2.4rem);
    overflow-wrap: anywhere;
  }

  .chair-session__entries {
    display: grid;
  }

  .chair-entry {
    display: grid;
    gap: 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--c-border);
    scroll-margin-top: calc(var(--nav-bar-height) + 52px);
  }

  .chair-entry__time,
  .chair-interlude__time {
    color: var(--c-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.77rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.025em;
    line-height: 1.5;
  }

  .chair-entry__time {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem;
  }

  .chair-entry__kind {
    width: 100%;
    color: var(--c-text-secondary);
    font-size: 0.59rem;
  }

  .speaker-heading {
    margin-bottom: 1.4rem;
  }

  .speaker-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 8vw, 2.05rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .speaker-affiliation {
    margin-top: 0.35rem;
    color: var(--c-text-secondary);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .speaker-heading h3 {
    margin: 1.1rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .chair-introduction {
    margin: 1.5rem 0;
    padding: 1.15rem 1.15rem 1.2rem;
    background: var(--c-bg-alt);
    border-left: 4px solid var(--c-ochre);
  }

  .chair-material-label {
    margin-bottom: 0.65rem;
    color: var(--c-accent-dark);
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .chair-introduction > p:last-child {
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .chair-pending {
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px dashed var(--c-rule);
    border-bottom: 1px dashed var(--c-rule);
  }

  .chair-pending strong {
    display: block;
    color: var(--c-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chair-pending p,
  .abstract-pending {
    margin-top: 0.5rem;
    color: var(--c-text-secondary);
    font-size: 0.9rem;
    font-style: italic;
    line-height: 1.55;
  }

  .abstract-pending {
    padding: 0.7rem 0;
    border-top: 1px solid var(--c-border);
  }

  .chair-entry details {
    margin-top: 0.75rem;
    border: 1px solid var(--c-border);
  }

  .chair-entry summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.8rem;
    color: var(--c-text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
    cursor: pointer;
  }

  .chair-entry summary::-webkit-details-marker {
    display: none;
  }

  .chair-entry summary::after {
    content: "+";
    flex: none;
    color: var(--c-accent-dark);
    font-size: 1rem;
  }

  .chair-entry details[open] summary {
    border-bottom: 1px solid var(--c-border);
  }

  .chair-entry details[open] summary::after {
    content: "−";
  }

  .details-copy {
    padding: 1rem 0.9rem 1.15rem;
  }

  .details-copy p {
    font-size: 0.97rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .chair-interlude {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px dashed var(--c-rule);
  }

  .chair-interlude__time {
    flex: 0 0 auto;
  }

  .chair-interlude__title {
    min-width: 0;
    color: var(--c-text-secondary);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  @media (min-width: 700px) {
    .chair-brief {
      padding-right: 1.5rem;
      padding-left: 1.5rem;
    }

    .chair-meta {
      flex-direction: row;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .session-jumps {
      margin-right: -1.5rem;
      margin-left: -1.5rem;
    }

    .chair-entry {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 1.5rem;
    }

    .chair-entry__time {
      align-content: start;
      padding-top: 0.15rem;
    }

    .chair-entry__kind {
      margin-top: 0.25rem;
    }

    .chair-interlude {
      padding-left: calc(96px + 1.5rem);
    }
  }
</style>
